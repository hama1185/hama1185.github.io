---
// src/pages/contact.astro
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import profile from '../data/profile.json';
import { ui } from '../lib/site';
import { t, type Lang } from '../lib/i18n';

const lang: Lang = 'en';
const email = profile.email.replace(' [at] ', '@');
---
<Base title="Contact" active="contact" lang={lang} width="read">
  <div class="wrap">
    <div class="intro">
      <h1>{t(ui.getInTouch, lang)}</h1>
      <p class="lead">共同研究・デモ・登壇のご相談など、お気軽にご連絡ください。Feel free to reach out about collaborations or talks.</p>

      <dl class="details">
        <div><dt>Email</dt><dd><a href={`mailto:${email}`}>{profile.email}</a></dd></div>
        <div><dt>Affiliation</dt><dd>{t(profile.role, lang)}<br />{t(profile.location, lang)}</dd></div>
        <div><dt>Elsewhere</dt><dd class="social">
          {profile.links.scholar && <a href={profile.links.scholar}>Google Scholar</a>}
          {profile.links.github  && <a href={profile.links.github}>GitHub</a>}
          {profile.links.x       && <a href={profile.links.x}>X</a>}
        </dd></div>
      </dl>
    </div>

    <form class="form" onsubmit="return false">
      <label>Name<input type="text" placeholder="Your name" /></label>
      <label>Email<input type="email" placeholder="you@example.com" /></label>
      <label>Message<textarea rows="4" placeholder="…"></textarea></label>
      <Button href="#" variant="primary">{t(ui.sendMessage, lang)}</Button>
    </form>
  </div>
</Base>

<style>
  .wrap { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; padding: 80px 0; }
  h1 { font-size: var(--text-h1); font-weight: 600; letter-spacing: -0.02em; }
  .lead { margin-top: 16px; font-size: 16px; line-height: 1.8; color: var(--color-text); max-width: 400px; }

  .details { margin: 36px 0 0; display: flex; flex-direction: column; gap: 18px; }
  .details dt { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-faint-text); margin-bottom: 5px; }
  .details dd { margin: 0; font-size: 14.5px; line-height: 1.6; color: var(--color-text); }
  .details a { color: var(--color-accent); }
  .social { display: flex; gap: 16px; }

  .form { background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: 32px; display: flex; flex-direction: column; gap: 16px; }
  .form label { display: flex; flex-direction: column; gap: 7px; font-size: 12.5px; font-weight: 500; color: var(--color-muted-text); }
  .form input, .form textarea {
    font: inherit; font-size: 13.5px; color: var(--color-text);
    background: var(--color-background); border: 1px solid var(--color-border);
    border-radius: var(--radius-sm); padding: 11px 14px; resize: vertical;
  }
  .form input:focus, .form textarea:focus { outline: none; border-color: var(--color-accent); }

  @media (max-width: 640px) {
    .wrap { grid-template-columns: 1fr; gap: 40px; padding: 40px 0; }
  }
</style>
