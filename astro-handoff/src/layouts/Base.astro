---
// src/layouts/Base.astro — document shell: head, fonts, tokens, nav, footer.
import '../styles/tokens.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { withBase, localizePath, stripBase, type Lang } from '../lib/i18n';

interface Props {
  title: string;
  active?: string;          // nav key of the current page
  lang?: Lang;
  width?: 'wide' | 'read';  // content max-width
}
const { title, active, lang = 'en', width = 'wide' } = Astro.props;

// Absolute URL of this page in each language (trailing slash = the URL GitHub Pages serves).
const currentPath = stripBase(Astro.url.pathname);
const altHref = (target: Lang): string =>
  new URL(withBase(localizePath(currentPath, target)).replace(/\/?$/, '/'), Astro.site ?? Astro.url).href;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="google-site-verification" content="ZhmRv7sktx0-gkARetR1-TVbbNoaRsTnchnifJLzUig" />
    <title>{title}</title>
    <link rel="alternate" hreflang="en" href={altHref('en')} />
    <link rel="alternate" hreflang="ja" href={altHref('ja')} />
    <link rel="alternate" hreflang="x-default" href={altHref('en')} />
    {lang === 'en' && (
      <script is:inline>
        // Send visitors whose browser prefers Japanese to the /ja/ version of this page.
        // Skipped once they pick a language in the nav, and when navigating within the site.
        // Only EN → JA: JA pages never redirect, so crawlers can index both versions.
        (function () {
          try { if (localStorage.getItem('lang-pref')) return; } catch (e) {}
          if (document.referrer.indexOf(location.origin + '/') === 0) return;
          var pref = (navigator.languages && navigator.languages[0]) || navigator.language || '';
          if (!/^ja(-|$)/i.test(pref)) return;
          var ja = document.querySelector('link[rel="alternate"][hreflang="ja"]');
          if (ja) location.replace(new URL(ja.href).pathname + location.search + location.hash);
        })();
      </script>
    )}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&family=Noto+Sans+JP:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Nav active={active} lang={lang} />
    <main class:list={['container', width]}>
      <slot />
    </main>
    <Footer lang={lang} />
    <style>
      .container { margin: 0 auto; padding: 0 var(--pad-page); }
      .container.wide { max-width: var(--maxw-wide); }
      .container.read { max-width: var(--maxw-read); }
    </style>
  </body>
</html>
