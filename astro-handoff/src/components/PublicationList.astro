---
// src/components/PublicationList.astro
// Full list grouped by category (journal / conference / domestic), each
// sorted by year descending. Props: limit (recent N, compact) | showFilter.
import PublicationItem from './PublicationItem.astro';
import pubsData from '../data/publications.json';
import { type Lang } from '../lib/i18n';

interface Props { limit?: number; showFilter?: boolean; lang?: Lang; }
const { limit, lang = 'en' } = Astro.props;

const pubs = [...pubsData].sort((a, b) => b.year - a.year);

// Recent (Home): flat compact list
const recent = limit ? pubs.slice(0, limit) : null;

// Full: fixed category sections, in display order. Each already year-sorted.
const categories = [
  { type: 'journal',    label: 'Journal Articles' },
  { type: 'conference', label: 'International Conferences' },
  { type: 'domestic',   label: 'Domestic Conferences' },
];
const groups = categories
  .map((c) => ({ ...c, items: pubs.filter((p) => p.venue.type === c.type) }))
  .filter((g) => g.items.length > 0);
---
{recent ? (
  <div class="recent">
    {recent.map((p) => <PublicationItem {...p} variant="compact" lang={lang} />)}
  </div>
) : (
  <div class="full">
    {groups.map((g) => (
      <section class="cat-group" data-type={g.type}>
        <h2 class="cat">{g.label}</h2>
        {g.items.map((p) => <PublicationItem {...p} variant="full" lang={lang} />)}
      </section>
    ))}
  </div>
)}

<style>
  .recent { display: flex; flex-direction: column; gap: 22px; }
  .cat { font-family: var(--font-mono); font-size: 13px; font-weight: 500; letter-spacing: 0.08em; color: var(--color-faint-text); padding-bottom: 14px; border-bottom: 1px solid var(--color-border); margin: 48px 0 0; }
  .cat-group:first-of-type .cat { margin-top: 0; }
</style>
