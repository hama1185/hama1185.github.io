---
// src/components/ThemeCard.astro
import { t, withBase, type Lang, type I18n } from '../lib/i18n';
interface Props {
  index: number;
  title: I18n; description: I18n; stats?: I18n; image?: string;
  variant?: 'compact' | 'detail';
  lang?: Lang;
}
const { index, title, description, stats, image, variant = 'compact', lang = 'en' } = Astro.props;
const num = String(index).padStart(2, '0');
const hasFig = variant === 'detail' && !!image;
const textOnly = variant === 'detail' && !image;
---
<article class:list={['card', variant, { 'no-fig': textOnly }]}>
  {textOnly ? (
    <>
      <div class="head-col">
        <div class="label">Theme {num}</div>
        <h3>{t(title, lang)}</h3>
        {stats && <div class="stats">{t(stats, lang)} ↗</div>}
      </div>
      <p class="body">{t(description, lang)}</p>
    </>
  ) : (
    <>
      <div class="content">
        <div class="label">Theme {num}</div>
        <h3>{t(title, lang)}</h3>
        <p>{t(description, lang)}</p>
        {stats && <div class="stats">{t(stats, lang)} ↗</div>}
      </div>
      {hasFig && <img class="fig" src={withBase(image)} alt={t(title, lang)} />}
    </>
  )}
</article>

<style>
  .card {
    background: var(--color-surface); border: 1px solid var(--color-border);
    border-radius: var(--radius-md); padding: 24px;
  }
  .card.detail { display: grid; grid-template-columns: 1fr 200px; gap: 32px; align-items: center; padding: 32px; }
  .card.detail.no-fig { grid-template-columns: 220px 1fr; gap: 48px; align-items: start; }
  .label { font-family: var(--font-mono); font-size: 10.5px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-accent); margin-bottom: 12px; }
  h3 { font-size: 18px; }
  .detail h3 { font-size: 23px; letter-spacing: -0.01em; }
  p { margin-top: 9px; font-size: 13.5px; line-height: 1.7; color: var(--color-muted-text); }
  .detail p { font-size: 15px; line-height: 1.75; max-width: 520px; }
  .no-fig .head-col .stats { margin-top: 16px; }
  .no-fig .body { margin-top: 2px; max-width: 620px; }
  .stats { margin-top: 18px; font-family: var(--font-mono); font-size: 11px; color: var(--color-accent); }
  .fig {
    width: 100%; height: 150px; object-fit: cover; display: block;
    border-radius: var(--radius-sm); border: 1px solid var(--color-border);
  }
  @media (max-width: 640px) {
    .card.detail { grid-template-columns: 1fr; gap: 20px; }
    .card.detail.no-fig { grid-template-columns: 1fr; gap: 14px; }
    .no-fig .body { max-width: none; }
    .fig { order: -1; }
  }
</style>
