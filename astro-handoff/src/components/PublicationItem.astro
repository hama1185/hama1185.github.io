---
// src/components/PublicationItem.astro
// variant: 'full' (venue column, links) | 'compact' (venue line above title)
import { t, type Lang, type I18n } from '../lib/i18n';

interface Props {
  title: I18n;
  authors: string[];
  self: string;
  venue: { short: string; type: string };
  year: number;
  links?: { pdf?: string; doi?: string; video?: string };
  award?: I18n;
  variant?: 'full' | 'compact';
  lang?: Lang;
}
const { title, authors, self, venue, year, links = {}, award, variant = 'full', lang = 'en' } = Astro.props;
const href = links.doi || links.pdf || '#';
---
<article class:list={['pub', variant]} data-type={venue.type}>
  {variant === 'full' && (
    <div class="venue">
      <div class="v-year">{year}</div>
      <div class="v-name">{venue.short}</div>
      <div class="v-type">{venue.type}</div>
    </div>
  )}
  <div class="body">
    {variant === 'compact' && (
      <div class="stamp">{year} · {venue.short}</div>
    )}
    <a class="title" href={href}>{t(title, lang)}</a>
    <p class="authors">
      {authors.map((a, i) => (
        <>{i > 0 && ', '}{a === self ? <strong>{a}</strong> : a}</>
      ))}
    </p>
    {variant === 'full' && (
      <div class="links">
        {links.pdf   && <a href={links.pdf}>PDF</a>}
        {links.doi   && <a href={links.doi}>DOI</a>}
        {links.video && <a href={links.video}>Video</a>}
      </div>
    )}
    {award && (
      <div class="award"><span class="award-ico" aria-hidden="true">🏆</span>{t(award, lang)}</div>
    )}
  </div>
</article>

<style>
  .pub.full { display: grid; grid-template-columns: 130px 1fr; gap: 24px; padding: 24px 0; border-bottom: 1px solid var(--color-subtle); }
  .pub.compact { display: flex; flex-direction: column; gap: 5px; }
  .venue { font-family: var(--font-mono); line-height: 1.45; text-transform: uppercase; }
  .v-year { font-size: 15px; font-weight: 700; color: var(--color-text); letter-spacing: 0.01em; }
  .v-name { margin-top: 3px; font-size: 11.5px; font-weight: 600; color: var(--color-text); }
  .v-type { margin-top: 1px; font-size: 10.5px; font-weight: 500; color: var(--color-muted-text); }
  .stamp { font-family: var(--font-mono); font-size: 11px; font-weight: 500; letter-spacing: 0.04em; color: var(--color-muted-text); }
  .title { font-size: 16.5px; font-weight: 600; color: var(--color-text); line-height: 1.45; }
  .compact .title { font-size: 15.5px; }
  .title:hover { color: var(--color-accent); }
  .authors { margin-top: 7px; font-size: 13.5px; color: var(--color-muted-text); }
  .authors strong { color: var(--color-text); font-weight: 600; }
  .links { display: flex; gap: 8px; margin-top: 12px; }
  .links a { font-family: var(--font-mono); font-size: 11px; color: var(--color-accent); border: 1px solid var(--color-accent-border); padding: 6px 11px; border-radius: 5px; min-height: 32px; display: inline-flex; align-items: center; }
  .award { display: inline-flex; align-items: center; gap: 5px; margin-top: 10px; font-family: var(--font-mono); font-size: 11px; font-weight: 600; color: var(--color-accent); }
  .award-ico { font-size: 12px; line-height: 1; opacity: 0.9; }
  @media (max-width: 640px) {
    .pub.full { grid-template-columns: 1fr; gap: 10px; }
    .venue { order: -1; }
  }
</style>
